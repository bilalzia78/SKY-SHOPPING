*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Arial}body{background:#f6f7fb;color:#111}
header{background:#fff;box-shadow:0 2px 15px rgba(0,0,0,.08);position:sticky;top:0;z-index:999;padding:10px}
.top{display:flex;align-items:center;justify-content:space-between;max-width:1100px;margin:auto}
.logo{width:50px;height:50px;border-radius:50%;background:url('logo.jpg') center/cover;border:2px solid gold}
.top h1{font-size:22px;color:#0a1a3d}.top h1 span{color:#f5a800}
nav{display:flex;gap:5px;max-width:1100px;margin:10px auto 0;overflow-x:auto;padding-bottom:5px}
nav a{white-space:nowrap;text-decoration:none;color:#444;padding:8px 14px;border-radius:20px;font-size:13px;font-weight:600}
nav a.active,nav a:hover{background:#0a1a3d;color:#fff}
.hero{background:linear-gradient(135deg,#0a1a3d,#1e4fa3);color:#fff;text-align:center;padding:45px 15px;border-radius:0 0 25px 25px}
.hero h2{font-size:30px;line-height:1.2}.hero p{margin:12px 0;opacity:.9}.hero button{background:#ffc107;border:none;padding:13px 22px;border-radius:30px;font-weight:800;margin:5px;cursor:pointer;color:#0a1a3d}
.search-box{max-width:650px;margin:-22px auto 20px;background:#fff;display:flex;padding:6px;border-radius:40px;box-shadow:0 10px 25px rgba(0,0,0,.12);position:relative;z-index:10}
.search-box input{flex:1;border:none;outline:none;padding:12px 15px}.search-box button{background:#0a1a3d;color:#fff;border:none;padding:11px 22px;border-radius:30px;font-weight:700;cursor:pointer}
.sec{max-width:1100px;margin:25px auto;padding:0 12px}.sec h2{font-size:20px;margin-bottom:12px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:15px}
.card{background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.06);padding-bottom:12px}
.card img{width:100%;height:230px;object-fit:cover}.card .pad{padding:12px}.card h3{font-size:15px}.card p{font-size:13px;color:#666;margin:5px 0}
.price{font-size:16px;font-weight:800;color:#0a1a3d}.price s{color:#999;font-size:13px}.profit{color:#0a9d4e;font-weight:700;font-size:13px}
.btn{width:100%;background:#0a1a3d;color:#fff;border:none;padding:11px;border-radius:12px;font-weight:700;cursor:pointer;margin-top:8px}.btn-gold{background:#ffc107;color:#0a1a3d}
.btn-outline{background:#fff;color:#0a1a3d;border:1.5px solid #0a1a3d}
.form-box{max-width:550px;margin:20px auto;background:#fff;padding:25px;border-radius:20px;box-shadow:0 8px 25px rgba(0,0,0,.07)}
.form-box input,.form-box textarea,.form-box select{width:100%;padding:12px;border:1.5px solid #e5e5e5;border-radius:12px;margin:6px 0;outline:none}
.stat{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}.stat div{background:#fff;padding:18px;border-radius:16px;text-align:center;box-shadow:0 4px 12px rgba(0,0,0,.05)}
.stat b{font-size:20px;color:#0a1a3d}
table{width:100%;border-collapse:collapse;background:#fff;border-radius:12px;overflow:hidden}th,td{padding:10px;text-align:left;font-size:13px;border-bottom:1px solid #eee}th{background:#0a1a3d;color:#fff}
footer{background:#0a1a3d;color:#fff;text-align:center;padding:30px 15px;margin-top:40px;border-radius:25px 25px 0 0}
@media(max-width:600px){.stat{grid-template-columns:1fr}.hero h2{font-size:24px}.card img{height:190px}}

